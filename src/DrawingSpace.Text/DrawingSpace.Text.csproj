<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>DrawingSpace.Text.Internal</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageLicenseExpression>Apache-2.0 AND MIT</PackageLicenseExpression>
    <Description>SkiaSharp 4 and HarfBuzz rich text layout, Unicode bidirectional processing, line breaking and styled paragraphs.</Description>
    <NoWarn>$(NoWarn);CS0618;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.3" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="8.3.1.3" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.3" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" Version="8.3.1.3" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="8.3.1.3" />
    <ProjectReference Include="../DrawingSpace.Documents/DrawingSpace.Documents.csproj" />
    <EmbeddedResource Include="Vendor/Resources/*.trie">
      <LogicalName>DrawingSpace.Text.Internal.Resources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <None Include="Vendor/LICENSE.txt" Pack="true" PackagePath="licenses/RichTextKit.txt" />
    <None Include="Vendor/NOTICE.md" Pack="true" PackagePath="licenses/RichTextKit-NOTICE.md" />
  </ItemGroup>
<ItemGroup><None Update="LICENSE.Apache-2.0.txt" Pack="true" PackagePath="licenses/" /><None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="licenses/" /></ItemGroup>
</Project>
