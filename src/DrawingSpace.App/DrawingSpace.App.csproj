<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(DrawingSpaceDesktopOnly)' == 'true'">net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType><UnoSingleProject>true</UnoSingleProject><UnoFeatures>SkiaRenderer;</UnoFeatures>
    <ApplicationTitle>DrawingSpace</ApplicationTitle><ApplicationId>io.github.wieslawsoltes.drawingspace</ApplicationId>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion><ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>DrawingSpace contributors</ApplicationPublisher>
    <Description>Local-first diagramming with Uno Platform and SkiaSharp.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><IsPackable>false</IsPackable>
    <UnoDisableHotDesign>true</UnoDisableHotDesign><UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <RunAOTCompilation>false</RunAOTCompilation><WasmShellGenerateAOTProfile>false</WasmShellGenerateAOTProfile>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../DrawingSpace.Workbench/DrawingSpace.Workbench.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.153.1" />
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/Storage.js" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>
</Project>
