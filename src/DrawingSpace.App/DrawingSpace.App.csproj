<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="'$(DrawingSpaceDesktopOnly)' == 'true'">net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType><UnoSingleProject>true</UnoSingleProject><UnoFeatures>SkiaRenderer;</UnoFeatures>
    <ApplicationTitle>DrawingSpace</ApplicationTitle><ApplicationId>io.github.wieslawsoltes.drawingspace</ApplicationId>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion><ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>DrawingSpace contributors</ApplicationPublisher>
    <Description>Local-first diagramming with Uno Platform and SkiaSharp.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><IsPackable>false</IsPackable>
    <UnoDisableHotDesign>true</UnoDisableHotDesign><UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <RunAOTCompilation>false</RunAOTCompilation><WasmShellGenerateAOTProfile>false</WasmShellGenerateAOTProfile>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../DrawingSpace.Workbench/DrawingSpace.Workbench.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.153.1" />
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/Storage.js" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-desktop'">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
  </ItemGroup>

  <!-- SkiaSharp's Dawn port passes -std=c++20 to emcc at link time. Uno's
       raw C GL shim is also compiled in that invocation. Wrap the unchanged
       upstream source as C++ with explicit C linkage, retaining its exact
       uno_gl_shim library name and every P/Invoke/GL entry point. Do not edit
       the NuGet cache or permit undefined native symbols. -->
  <Target Name="DrawingSpacePrepareUnoGlShim"
          BeforeTargets="_UnoAdjustCompatibility"
          Condition="'$(TargetFramework)' == 'net10.0-browserwasm' and '$(_SkiaSharpUseEmdawnwebgpu)' == 'true'">
    <ItemGroup>
      <_DrawingSpaceUnoCShim Include="@(WasmShellNativeCompile)"
                             Condition="'%(Filename)%(Extension)' == 'uno_gl_shim.c'" />
    </ItemGroup>
    <Error Condition="'@(_DrawingSpaceUnoCShim->Count())' != '1'"
           Text="Expected exactly one Uno GL C shim. Review the SkiaSharp/Uno native integration after upgrading dependencies." />
    <PropertyGroup>
      <_DrawingSpaceUnoCShimPath>@(_DrawingSpaceUnoCShim->'%(FullPath)')</_DrawingSpaceUnoCShimPath>
      <_DrawingSpaceUnoCShimPath>$([System.String]::Copy('$(_DrawingSpaceUnoCShimPath)').Replace('\','/'))</_DrawingSpaceUnoCShimPath>
      <_DrawingSpaceUnoCppShim>$(IntermediateOutputPath)native/uno_gl_shim.cpp</_DrawingSpaceUnoCppShim>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)native" />
    <!-- Emscripten headers contain C++ templates. Include them BEFORE the
         linkage block; their guards prevent reinclusion by the C source. -->
    <WriteLinesToFile File="$(_DrawingSpaceUnoCppShim)"
                      Lines="#include &lt;GLES3/gl3.h&gt;&#xA;#include &lt;emscripten.h&gt;&#xA;#include &lt;emscripten/html5_webgl.h&gt;&#xA;#include &lt;string.h&gt;&#xA;#include &lt;stdint.h&gt;&#xA;extern &quot;C&quot; {&#xA;#include &quot;$(_DrawingSpaceUnoCShimPath)&quot;&#xA;}"
                      Encoding="UTF-8" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <WasmShellNativeCompile Remove="@(_DrawingSpaceUnoCShim)" />
      <WasmShellNativeCompile Include="$(_DrawingSpaceUnoCppShim)" Visible="false" />
      <FileWrites Include="$(_DrawingSpaceUnoCppShim)" />
    </ItemGroup>
  </Target>
</Project>
